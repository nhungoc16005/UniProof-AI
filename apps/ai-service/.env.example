# ==============================================================================
# EduPoint AI Service (.env mẫu — Sao chép thành .env và điền key trên máy local)
# TUYỆT ĐỐI KHÔNG COMMIT FILE .env CHỨA KEY THẬT LÊN GIT
# ==============================================================================

PORT=8000
OCR_ENGINE=rapidocr_vietocr

# --- Giai đoạn 3: Trợ lý Hybrid Groq LLM (DEC-015) ---
# Đổi thành true sau khi đã điền GROQ_API_KEY để kích hoạt hỗ trợ cho ~15-20% ca khó (conf < 0.65).
# Khi để false hoặc thiếu key, hệ thống chạy 100% nội bộ bằng PhoBERT ONNX.
EXTERNAL_LLM_EXTRACTION_ENABLED=false
GROQ_API_KEY=
LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_GATEKEEPER_CONFIDENCE_THRESHOLD=0.65
LLM_TIMEOUT_SECONDS=4.0

# --- Tùy chọn: Search API có cấu trúc cho Luồng 2 (Hoạt động ngoài trường) ---
SERP_API_KEY=
